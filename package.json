{
  "name": "dsh-hud",
  "version": "1.6.1",
  "description": "A HUD status panel for DSH web: git status, MCP servers, skills, model and token usage in a floating side panel",
  "icon": "assets/icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "assets",
    "locale"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "hud",
    "git",
    "git-status",
    "mcp",
    "web-ui"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.0.1",
    "node": ">=22.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/a903067276-rgb/dsh-hud.git"
  },
  "dsh": {
    "compatibility": {
      "dshReleases": {
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      }
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3"
  }
}
